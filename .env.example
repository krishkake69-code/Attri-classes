# Required for the admin panel to work. If unset, admin login is disabled.
ADMIN_PASSWORD=

# Optional: used to sign admin session tokens instead of deriving the key
# from ADMIN_PASSWORD. Recommended in production.
AUTH_SECRET=

GEMINI_API_KEY=
NODE_ENV=development

# Optional: Vercel KV credentials. Leave empty for local file storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=
